# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.output/
.vite/

# Env / secrets
# .env is committed (Vite reads VITE_* into import.meta.env; safe to share).
# .env.local and .env.<mode>.local are per-developer overrides — never commit.
.env.local
.env.*.local

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/

# Agency / APM runtime
/.do-results.json
/apm_modules/


# APM dependencies
apm_modules/

# Agent scratch — /brainstorm and /develop working notes per topic. The
# canonical PR artifact is `implementation-docs/<topic-slug>.md`; `notes/`
# is intermediate state and not committed.
notes/

# Playwright MCP scratch (browser-context dumps from ad-hoc verification runs).
.playwright-mcp/

# Personal/local files that don't belong in the repo (not project artifacts).
/Finance 2026.xlsx

# direnv local dev override (LD_LIBRARY_PATH fix for Playwright/glibc) — see
# the file's own header comment: local convenience only, never tracked.
/.envrc
