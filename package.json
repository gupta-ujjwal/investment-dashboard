{
  "name": "investment-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Edge dashboard for tracking personal investments across the Indian and US stock markets. No backend, no accounts — everything stays in your browser.",
  "license": "MIT",
  "author": "Ujjwal Gupta",
  "repository": {
    "type": "git",
    "url": "https://github.com/gupta-ujjwal/investment-dashboard.git"
  },
  "homepage": "https://gupta-ujjwal.github.io/investment-dashboard/",
  "keywords": [
    "investment-tracker",
    "portfolio",
    "personal-finance",
    "react",
    "vite",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/validateData.mjs",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "validate:data": "node scripts/validateData.mjs",
    "refresh:benchmarks": "node scripts/refresh-benchmarks.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "framer-motion": "^13.1.1",
    "idb": "^8.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
